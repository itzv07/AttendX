rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isFaculty() {
      return hasRole('faculty') || isAdmin();
    }

    function isStudent() {
      return hasRole('student');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isUser(userId);
    }

    // Departments & Courses
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Sections & Enrollments
    match /sections/{sectionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isFaculty();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /faculty_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Attendance Sessions
    match /attendance_sessions/{sessionId} {
      // Anyone authenticated can read active sessions for UI live display
      allow read: if isAuthenticated();
      // Only faculty assigned to this class or Admin can create or update sessions
      allow create: if isFaculty();
      allow update: if isFaculty() && (
        resource.data.facultyId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Attendance Records
    match /attendance_records/{recordId} {
      // Students can read their own records
      // Faculty can read records for sessions they own
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isFaculty() ||
        isAdmin()
      );
      // Writes must occur through trusted Cloud Functions or Admin manual override
      allow write: if isAdmin();
    }

    // Devices Collection (Hardware Locks)
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // Correction Requests
    match /correction_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isFaculty() || isAdmin()
      );
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isFaculty() || isAdmin();
      allow delete: if isAdmin();
    }

    // Audit Logs (Append-only by backend, readable by Admin)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only (using Admin SDK)
    }
  }
}
